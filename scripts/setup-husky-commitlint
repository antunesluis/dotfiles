#!/bin/bash

# Configura Husky (v9+) e Commitlint num projeto Node, com os hooks numa pasta
# oculta em vez de .husky/ e a configuração do Commitlint no package.json.

HOOKS_DIR=".config-git-tools/husky"

set -e

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Erro: rode dentro de um repositório git."
    exit 1
fi

if [ ! -f "package.json" ]; then
    echo "Criando package.json..."
    npm init -y >/dev/null
fi

echo "Instalando Husky e Commitlint..."
npm install --save-dev husky @commitlint/cli @commitlint/config-conventional

echo "Configurando hooks em $HOOKS_DIR..."
mkdir -p "$HOOKS_DIR"
npm pkg set scripts.prepare="husky $HOOKS_DIR"
npx husky "$HOOKS_DIR"

printf '%s\n' 'npx --no -- commitlint --edit "$1"' >"$HOOKS_DIR/commit-msg"

if [ -z "$(npm pkg get commitlint | tr -d '{}')" ]; then
    echo "Configurando Commitlint no package.json..."
    npm pkg set 'commitlint.extends[0]=@commitlint/config-conventional'
fi

echo "Configuração concluída."
echo "Hooks em $HOOKS_DIR (core.hooksPath = $(git config core.hooksPath))."
