# ============================================================
# Fonte
# ============================================================

font-family = Iosevka Nerd Font
font-size = 14

# ============================================================
# Tema
# ============================================================

theme = Kanagawa Wave

# ============================================================
# Janela
# ============================================================

window-decoration = none

window-padding-x = 5
window-padding-y = 3
window-padding-balance = true

window-width = 128
window-height = 38

# Mantém a interface GTK escura
window-theme = dark

# ============================================================
# Cursor
# ============================================================

cursor-style = bar
cursor-style-blink = true

mouse-hide-while-typing = true

# ============================================================
# Seleção e histórico
# ============================================================

# Copia o texto selecionado para o clipboard do sistema
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

# O Ghostty mede o histórico em bytes, não em linhas
scrollback-limit = 50000000

# ============================================================
# Shell
# ============================================================

command = /bin/zsh

shell-integration = detect

# Melhora integração com sudo, SSH, título e terminfo
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# ============================================================
# Comportamento
# ============================================================

confirm-close-surface = true
window-step-resize = true
window-subtitle = working-directory

# Realce discreto quando usar splits nativos do Ghostty
unfocused-split-opacity = 0.85
split-divider-color = #54546d


# ============================================================
# Notificacao
# ============================================================

# Notifica quando um comando com mais de 10 segundos terminar
# e o Ghostty não estiver em foco
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 10s

# Remove a notificação visual para cada texto copiado,
# mas mantém a notificação de recarregamento da configuração
app-notifications = no-clipboard-copy,config-reload
