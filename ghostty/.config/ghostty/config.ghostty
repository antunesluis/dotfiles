# ============================================================
# Fonte
# ============================================================

font-family = Iosevka Nerd Font
font-size = 14

# ============================================================
# Tema
# ============================================================

theme = Kanagawa Wave

# ============================================================
# Janela
# ============================================================

# window-decoration = none

window-padding-x = 5
window-padding-y = 3
window-padding-balance = true

window-width = 128
window-height = 38

# Mantém a interface GTK escura
window-theme = dark

# ============================================================
# Barra de título
# ============================================================

# Uma linha só no centro: o título (definido pelo zsh como o
# caminho completo). Sem subtítulo, que antes repetia o caminho.
window-subtitle = false

# Esconde o botão "Nova aba / Split" do canto esquerdo
gtk-custom-css = custom.css

# ============================================================
# Cursor
# ============================================================

cursor-style = bar
cursor-style-blink = true

mouse-hide-while-typing = true

# ============================================================
# Seleção e histórico
# ============================================================

# Copia o texto selecionado para o clipboard do sistema
copy-on-select = clipboard
clipboard-read = ask
clipboard-write = allow

# O Ghostty mede o histórico em bytes, não em linhas
scrollback-limit = 50000000

# ============================================================
# Shell
# ============================================================

command = /bin/zsh

shell-integration = detect

# Melhora integração com sudo, SSH e terminfo.
# `no-title`: o título automático do Ghostty (só as 3 últimas
# pastas) fica desligado - quem define o título é o hook no
# .zshrc, que mostra o caminho completo.
shell-integration-features = cursor,sudo,no-title,ssh-env,ssh-terminfo,path

# ============================================================
# Comportamento
# ============================================================

confirm-close-surface = true
window-step-resize = true

# Realce discreto quando usar splits nativos do Ghostty
unfocused-split-opacity = 0.85
split-divider-color = #54546d

###############################################################

# background-opacity = 0.96


# ============================================================
# Notificacao
# ============================================================

# Notifica quando um comando com mais de 10 segundos terminar
# e o Ghostty não estiver em foco
notify-on-command-finish = unfocused
# Atenção: isto é uma lista de flags, não um valor único.
# Escrever só `notify` NÃO desliga o `bell` (que vem ligado por
# padrão). Troque por `no-bell,notify` se quiser sem o bell.
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 10s

# Remove a notificação visual para cada texto copiado,
# mas mantém a notificação de recarregamento da configuração
app-notifications = no-clipboard-copy,config-reload
