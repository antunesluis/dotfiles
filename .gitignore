# Tmux plugins (TPM)
tmux/.config/tmux/plugins/*
!tmux/.config/tmux/plugins/.gitkeep

# Nvim
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/.luarc.json

# Temporários e backups
*.swp
*.swo
*~
.DS_Store
.netrwhist

# Logs
*.log

# Cache
.cache/

# Codex local state and secrets
#
# config.toml não é versionado: o Codex grava nele trust levels, plugins e
# marketplaces com caminhos absolutos desta máquina. Só AGENTS.md, hooks.json e
# o hook do herdr vêm do repositório.
codex/.codex/config.toml
codex/.codex/auth.json
codex/.codex/history.jsonl
codex/.codex/models_cache.json
codex/.codex/installation_id
codex/.codex/*.sqlite
codex/.codex/*.sqlite-shm
codex/.codex/*.sqlite-wal
codex/.codex/cache/
codex/.codex/logs/
codex/.codex/logs_*.sqlite*
codex/.codex/state_*.sqlite*
codex/.codex/goals_*.sqlite*
codex/.codex/memories_*.sqlite*
codex/.codex/shell_snapshots/
codex/.codex/.tmp/

# Claude Code local state and machine-specific settings
#
# The claude package MUST be stowed with --no-folding (see README). ~/.claude
# holds runtime state and ~/.claude/.credentials.json holds an auth token; if
# stow ever folds the directory into this repo, Claude Code writes all of that
# inside git. The entries below are defence in depth for exactly that mistake:
# only hooks/, rules/, skills/, CLAUDE.md and settings.json belong in here.
claude/.claude.json
claude/.claude/settings.local.json

# Credentials -- never version.
claude/.claude/.credentials.json

claude/.claude/cache/
claude/.claude/backups/
claude/.claude/projects/
claude/.claude/todos/
claude/.claude/statsig/
claude/.claude/sessions/
claude/.claude/session-env/
claude/.claude/shell-snapshots/
claude/.claude/file-history/
claude/.claude/paste-cache/
claude/.claude/image-cache/
claude/.claude/downloads/
claude/.claude/telemetry/
claude/.claude/daemon/
claude/.claude/plugins/
claude/.claude/jobs/
claude/.claude/tasks/
claude/.claude/.last-cleanup

# Herdr local state
# ~/.config/herdr is a directory symlink into this repo, so the herdr server
# writes its runtime state here. session.json holds absolute per-machine paths
# and would conflict on every sync between machines.
herdr/.config/herdr/*.sock
herdr/.config/herdr/cache/
herdr/.config/herdr/state/
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock

# OpenCode local dependencies and state
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package-lock.json
opencode/.config/opencode/bun.lock
