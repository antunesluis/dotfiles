#!/bin/bash

# Reinstala as dependências de um projeto Node do zero, preservando o lockfile.
# O gerenciador vem do lockfile presente, e a instalação segue as versões
# travadas nele (ci / frozen-lockfile).

if [ ! -f "package.json" ]; then
    echo "Erro: não foi encontrado um package.json neste diretório."
    exit 1
fi

if [ -f "pnpm-lock.yaml" ]; then
    install=(pnpm install --frozen-lockfile)
elif [ -f "yarn.lock" ]; then
    install=(yarn install --frozen-lockfile)
elif [ -f "package-lock.json" ]; then
    install=(npm ci)
else
    install=(npm install)
fi

if ! command -v "${install[0]}" >/dev/null 2>&1; then
    echo "Erro: ${install[0]} não está instalado."
    exit 1
fi

echo "Removendo node_modules..."
rm -rf node_modules

if [ -d "build" ]; then
    echo "Removendo a pasta build..."
    rm -rf build
fi

echo "Reinstalando dependências com: ${install[*]}"
"${install[@]}" || exit 1

echo "Reset finalizado."
