# Tmux plugins (TPM)
tmux/.config/tmux/plugins/*
!tmux/.config/tmux/plugins/.gitkeep

# Nvim
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/.luarc.json

# Temporários e backups
*.swp
*.swo
*~
.DS_Store
.netrwhist

# Logs
*.log

# Cache
.cache/

# Codex local state and secrets
codex/.codex/auth.json
codex/.codex/history.jsonl
codex/.codex/models_cache.json
codex/.codex/installation_id
codex/.codex/*.sqlite
codex/.codex/*.sqlite-shm
codex/.codex/*.sqlite-wal
codex/.codex/cache/
codex/.codex/logs/
codex/.codex/logs_*.sqlite*
codex/.codex/state_*.sqlite*
codex/.codex/goals_*.sqlite*
codex/.codex/memories_*.sqlite*
codex/.codex/shell_snapshots/
codex/.codex/.tmp/

# Claude Code local state and machine-specific settings
claude/.claude.json
claude/.claude/settings.local.json
claude/.claude/cache/
claude/.claude/backups/
claude/.claude/projects/
claude/.claude/todos/
claude/.claude/statsig/

# Herdr local state
# ~/.config/herdr is a directory symlink into this repo, so the herdr server
# writes its runtime state here. session.json holds absolute per-machine paths
# and would conflict on every sync between machines.
herdr/.config/herdr/*.sock
herdr/.config/herdr/cache/
herdr/.config/herdr/state/
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock

# OpenCode local dependencies and state
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package-lock.json
opencode/.config/opencode/bun.lock
